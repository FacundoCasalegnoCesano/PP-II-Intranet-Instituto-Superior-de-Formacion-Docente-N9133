{
  "name": "backend-instituto",
  "version": "1.0.0",
  "description": "Backend API para sistema de gestión académica con MariaDB y TypeScript",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "prisma:generate": "prisma generate",
