generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. ENUMS
// ============================================
// ✅ El enum Rol se elimina: ahora Usuario.rol es un string
// con valores separados por coma (ej: "ALUMNO", "PROFESOR,ADMINISTRATIVO")

enum TipoEspacioCurricular {
  MATERIA
  SEMINARIO
  TALLER
  TALLER_PRACTICA
}

enum ModalidadMateria {
  PRESENCIAL
  SEMIPRESENCIAL
  LIBRE
}

enum PeriodoMateria {
  ANUAL
  PRIMER_CUATRIMESTRE
  SEGUNDO_CUATRIMESTRE
}

enum RegimenEvaluacion {
  REGULAR_PRESENCIAL_PROMOCION
  REGULAR_PRESENCIAL_SIN_PROMOCION
  REGULAR_SEMIPRESENCIAL
  LIBRE
}

enum TipoRequisitoCorrelatividad {
  OBLIGATORIA
  ALTERNATIVA
  GRUPO
}

enum EstadoInscripcionMateria {
  ACTIVA
  BAJA
  FINALIZADA
  RECURSANDO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoCalificacion {
  PARCIAL
  RECUPERATORIO
  COLOQUIO
  EXAMEN_FINAL
  TRABAJO_PRACTICO
  PROMOCION
}

enum TipoExamen {
  ORAL
  ESCRITO
}

enum RolTribunal {
  PRESIDENTE
  VOCAL
  SUPLENTE
}

enum EstadoMesa {
  ABIERTA
  EN_PROCESO
  FINALIZADA
}

enum OrigenMesa {
  ORDINARIA
  HISTORICA
}

enum AccionResultadoMesa {
  CIERRE
  REAPERTURA
  CORRECCION
}

enum CondicionExamen {
  REGULAR
  LIBRE
}

enum TipoHomologacion {
  TOTAL
  PARCIAL
}

enum EstadoHomologacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoPeriodo {
  MATERIA
  EXAMEN
}

// ============================================
// 2. MODELO SESION
// ============================================

model Sesion {
  id                 Int       @id @default(autoincrement())
  token              String    @unique @db.VarChar(500)
  refreshTokenHash   String?   @map("refresh_token_hash") @db.VarChar(255)
  refreshTokenExpira DateTime? @map("refresh_token_expira")
  familiaId          String    @default(uuid()) @map("familia_id") @db.VarChar(36)
  usuarioId          Int       @map("usuario_id")
  creadaEn           DateTime  @default(now()) @map("creada_en")
  expiraEn           DateTime  @map("expira_en")
  cerradaEn          DateTime? @map("cerrada_en")
  revocadaEn         DateTime? @map("revocada_en")
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario])

  @@unique([usuarioId, token])
  @@index([familiaId])
  @@map("sesiones")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([usuarioId, usedAt])
  @@map("password_reset_tokens")
}

// ============================================
// 3. USUARIO / ALUMNO
// ============================================

/// Usuario base: sirve para Alumno, Profesor y Administrativo.
/// El rol es un string (1..N separados por coma); los permisos se derivan de él.
/// Profesor/Administrativo NO tienen tabla propia: solo Usuario con su rol.
model Usuario {
  idUsuario          Int       @id @default(autoincrement())
  apellidoNombre     String    @db.VarChar(255)
  dni                Int       @unique
  email              String    @unique @db.VarChar(255)
  fechaNacimiento    DateTime  @db.Date
  telefono           String    @db.VarChar(20) // string: admite +54, 0 iniciales
  passwordHash       String    @db.VarChar(255)
  cuil               String?   @unique @db.VarChar(11) // 11 dígitos: no entra en Int (2.1B máx)
  activo             Boolean   @default(true)
  /// Roles del usuario separados por coma: "ALUMNO", "PROFESOR,ADMINISTRATIVO"
  rol                String    @db.VarChar(255)
  contactoEmergencia String?   @db.VarChar(255)
  foto               String?   @db.VarChar(255) // URL del almacenamiento
  backupCodes        String?   @db.Text // JSON string: string[] de hashes bcrypt
  ultimoAcceso       DateTime? @map("ultimo_acceso")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  loginFailedCount   Int       @default(0) @map("login_failed_count")
  loginLockedUntil   DateTime? @map("login_locked_until")

  alumno                       Alumno?
  sesiones                     Sesion[]
  passwordResetTokens          PasswordResetToken[]
  inscripcionesCarrera         InscripcionCarrera[]
  cursadasDocente              Cursada[]                @relation("DocenteCursada")
  profesorMaterias             ProfesorMateria[]
  mesasTribunal                MesaTribunal[]
  auditoriasResultados         MesaResultadoAuditoria[]
  promocionesHistoricasCreadas PromocionHistorica[]       @relation("PromocionHistoricaCreador")
  auditoriasPromociones        PromocionHistoricaAuditoria[]
  documentosHorariosPublicados DocumentoHorario[]       @relation("DocumentoHorarioPublicador")

  @@map("Usuario")
}

/// Única clase con tabla propia además de Usuario (1:1). Solo existe si
/// rol contiene "ALUMNO". idCuenta = idUsuario generado en Usuario (FK).
/// Al eliminar el Usuario se elimina el Alumno en cascada (spec de DELETE).
model Alumno {
  idAlumno               Int     @id @default(autoincrement())
  idCuenta               Int     @unique // FK → Usuario.idUsuario
  usuario                Usuario @relation(fields: [idCuenta], references: [idUsuario], onDelete: Cascade)
  domicilio              String  @db.VarChar(255)
  institucionProcedencia String? @db.VarChar(255)
  /// Solo interesa si adeuda materias o no (bloquea promoción/rendir).
  adeudaMateria          Boolean @default(false)
  anioEgreso             Int? // año de egreso del secundario (legacy)

  inscripcionesMateria InscripcionMateria[]
  inscripcionesEspacio InscripcionEspacio[]
  inscripcionesExamen  InscripcionExamen[]
  promocionesHistoricas PromocionHistorica[]
  homologaciones       Homologacion[]
  cursos               AlumnoCurso[]
  espaciosCurriculares AlumnoEspacioCurricular[]
  asistencias          Asistencia[]
  calificaciones       Calificacion[]

  @@index([idCuenta])
  @@map("Alumno")
}

// ============================================
// 4. RESTO DE MODELOS
// ============================================

model Carrera {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(255)
  duracionAnios Int      @map("duracion_anios")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  materias              Materia[]
  espaciosCurriculares  EspacioCurricular[]
  inscripciones         InscripcionCarrera[]
  planesEstudio         PlanEstudio[]
  documentosHorarios    DocumentoHorario[]
  publicacionesHorarios PublicacionHorario[]

  @@map("carreras")
}

model Materia {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(255)
  descripcion         String?               @db.Text
  cargaHoraria        Int                   @map("carga_horaria")
  horasCatedra        String?               @map("horas_catedra") @db.VarChar(50)
  tipoEspacio         TipoEspacioCurricular @default(MATERIA) @map("tipo_espacio")
  modalidad           ModalidadMateria?     @default(PRESENCIAL)
  periodo             PeriodoMateria?       @default(ANUAL)
  regimen             RegimenEvaluacion?    @default(REGULAR_PRESENCIAL_SIN_PROMOCION)
  notaMinima          Float?                @default(6) @map("nota_minima")
  asistenciaRequerida Float?                @default(75) @map("asistencia_requerida")
  tpRequeridos        Float?                @default(75) @map("tp_requeridos")
  esPromocionable     Boolean               @default(false) @map("es_promocionable")
  notaPromocion       Float?                @default(8) @map("nota_promocion")
  aniosRegularidad    Int?                  @default(3) @map("anios_regularidad")
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  carreraId Int     @map("carrera_id")
  carrera   Carrera @relation(fields: [carreraId], references: [id])

  cursoId Int?   @map("curso_id")
  curso   Curso? @relation(fields: [cursoId], references: [id])

  espacioCurricularId Int?               @map("espacio_curricular_id")
  espacioCurricular   EspacioCurricular? @relation(fields: [espacioCurricularId], references: [id])

  planEstudioId Int?         @map("plan_estudio_id")
  planEstudio   PlanEstudio? @relation(fields: [planEstudioId], references: [id])

  correlatividadesRequeridas       Correlatividad[]        @relation("MateriaRequerida")
  correlatividadesOrigen           Correlatividad[]        @relation("MateriaOrigen")
  correlatividadesEspacioRequerida EspacioCorrelatividad[]

  inscripciones         InscripcionMateria[]
  cursadas              Cursada[]
  mesas                 Mesa[]
  profesorMaterias      ProfesorMateria[]
  homologaciones        Homologacion[]
  librosDeTemas         LibroDeTema[]
  periodosHabilitadores PeriodoMateriaHabilitada[]

  @@unique([carreraId, nombre], map: "materias_carrera_nombre_unique")
  @@map("materias")
}

model EspacioCurricular {
  id                     Int       @id @default(autoincrement())
  carreraId              Int?      @map("carrera_id")
  nombre                 String    @db.VarChar(255)
  descripcion            String?   @db.Text
  activo                 Boolean   @default(false)
  composicionBloqueadaAt DateTime? @map("composicion_bloqueada_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  carrera                   Carrera?                  @relation(fields: [carreraId], references: [id])
  materias                  Materia[]
  cursadas                  CursadaEspacio[]
  alumnoEspacios            AlumnoEspacioCurricular[]
  correlatividadesOrigen    EspacioCorrelatividad[]   @relation("EspacioCorrelatividadOrigen")
  correlatividadesRequerido EspacioCorrelatividad[]   @relation("EspacioCorrelatividadRequerido")
  correlatividadesRequeridoMateria Correlatividad[]   @relation("EspacioRequeridoEnCorrelatividad")

  @@unique([carreraId, nombre], map: "espacios_carrera_nombre_unique")
  @@map("espacios_curriculares")
}

model Curso {
  id          Int      @id @default(autoincrement())
  anio        Int
  descripcion String   @db.VarChar(255)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materias Materia[]
  alumnos  AlumnoCurso[]

  @@unique([anio, descripcion])
  @@map("cursos")
}

model AlumnoCurso {
  id               Int      @id @default(autoincrement())
  alumnoId         Int      @map("alumno_id")
  cursoId          Int      @map("curso_id")
  fechaInscripcion DateTime @default(now()) @map("fecha_inscripcion")
  activo           Boolean  @default(true)

  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno])
  curso  Curso  @relation(fields: [cursoId], references: [id])

  @@unique([alumnoId, cursoId])
  @@map("alumnos_cursos")
}

model AlumnoEspacioCurricular {
  id                  Int      @id @default(autoincrement())
  alumnoId            Int      @map("alumno_id")
  espacioCurricularId Int      @map("espacio_curricular_id")
  promedio            Float?   @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  alumno            Alumno            @relation(fields: [alumnoId], references: [idAlumno])
  espacioCurricular EspacioCurricular @relation(fields: [espacioCurricularId], references: [id])

  @@unique([alumnoId, espacioCurricularId], map: "alumnos_espacios_curriculares_unique")
  @@map("alumnos_espacios_curriculares")
}

model Correlatividad {
  id                      Int                         @id @default(autoincrement())
  materiaOrigenId         Int                         @map("materia_origen_id")
  materiaRequeridaId      Int?                        @map("materia_requerida_id")
  espacioRequeridoId      Int?                        @map("espacio_requerido_id")
  tipoRequisito           TipoRequisitoCorrelatividad @default(OBLIGATORIA) @map("tipo_requisito")
  grupo                   String?                     @db.VarChar(100)
  cantidadMinimaAprobadas Int?                        @map("cantidad_minima_aprobadas")
  aplicaCursado           Boolean                     @default(true) @map("aplica_cursado")
  aplicaRendir            Boolean                     @default(true) @map("aplica_rendir")
  suspendidaPorEspacio    Boolean                     @default(false) @map("suspendida_por_espacio")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  materiaOrigen    Materia            @relation("MateriaOrigen", fields: [materiaOrigenId], references: [id])
  materiaRequerida Materia?           @relation("MateriaRequerida", fields: [materiaRequeridaId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "correlatividades_materia_destino_fkey")
  espacioRequerido EspacioCurricular? @relation("EspacioRequeridoEnCorrelatividad", fields: [espacioRequeridoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "correlatividades_espacio_requerido_id_fkey")

  @@unique([materiaOrigenId, materiaRequeridaId, grupo], map: "correlatividades_origen_requerida_grupo_unique")
  @@unique([materiaOrigenId, espacioRequeridoId, grupo], map: "correlatividades_origen_espacio_grupo_unique")
  @@index([espacioRequeridoId], map: "correlatividades_espacio_requerido_id_idx")
  @@map("correlatividades")
}

model EspacioCorrelatividad {
  id                 Int      @id @default(autoincrement())
  espacioOrigenId    Int      @map("espacio_origen_id")
  materiaRequeridaId Int?     @map("materia_requerida_id")
  espacioRequeridoId Int?     @map("espacio_requerido_id")
  aplicaCursado      Boolean  @default(true) @map("aplica_cursado")
  aplicaRendir       Boolean  @default(true) @map("aplica_rendir")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  espacioOrigen    EspacioCurricular  @relation("EspacioCorrelatividadOrigen", fields: [espacioOrigenId], references: [id])
  materiaRequerida Materia?           @relation(fields: [materiaRequeridaId], references: [id])
  espacioRequerido EspacioCurricular? @relation("EspacioCorrelatividadRequerido", fields: [espacioRequeridoId], references: [id])

  @@index([espacioOrigenId])
  @@map("espacios_correlatividades")
}

model PlanEstudio {
  id          Int      @id @default(autoincrement())
  carreraId   Int      @map("carrera_id")
  anio        Int
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  carrera  Carrera   @relation(fields: [carreraId], references: [id])
  materias Materia[]

  @@unique([carreraId, anio])
  @@map("planes_estudio")
}

model InscripcionCarrera {
  id               Int       @id @default(autoincrement())
  usuarioId        Int       @map("usuario_id")
  carreraId        Int       @map("carrera_id")
  fechaInscripcion DateTime  @default(now()) @map("fecha_inscripcion")
  fechaBaja        DateTime? @map("fecha_baja")
  cicloLectivo     Int?      @map("ciclo_lectivo")
  anioCohorte      Int?      @map("anio_cohorte")
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario])
  carrera Carrera @relation(fields: [carreraId], references: [id])

  @@unique([usuarioId, carreraId])
  @@map("inscripciones_carreras")
}

model InscripcionMateria {
  id               Int                      @id @default(autoincrement())
  alumnoId         Int                      @map("alumno_id")
  materiaId        Int                      @map("materia_id")
  fechaInscripcion DateTime                 @default(now()) @map("fecha_inscripcion")
  fechaBaja        DateTime?                @map("fecha_baja")
  cicloLectivo     Int                      @map("ciclo_lectivo")
  modalidadElegida ModalidadMateria         @default(PRESENCIAL) @map("modalidad_elegida")
  estado           EstadoInscripcionMateria @default(ACTIVA)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  alumno  Alumno  @relation(fields: [alumnoId], references: [idAlumno])
  materia Materia @relation(fields: [materiaId], references: [id])

  cursadaId Int?     @map("cursada_id")
  cursada   Cursada? @relation(fields: [cursadaId], references: [id])

  inscripcionEspacioId Int?                @map("inscripcion_espacio_id")
  inscripcionEspacio   InscripcionEspacio? @relation(fields: [inscripcionEspacioId], references: [id], onDelete: Restrict, map: "inscripciones_materias_espacio_fkey")
  examenes             InscripcionExamen[]
  promocionHistorica   PromocionHistorica?

  @@unique([alumnoId, materiaId, cicloLectivo])
  @@unique([inscripcionEspacioId, materiaId], map: "inscripciones_materias_espacio_materia_unique")
  @@index([inscripcionEspacioId], map: "inscripciones_materias_espacio_idx")
  @@map("inscripciones_materias")
}

model InscripcionEspacio {
  id               Int                      @id @default(autoincrement())
  alumnoId         Int                      @map("alumno_id")
  cursadaEspacioId Int                      @map("cursada_espacio_id")
  fechaInscripcion DateTime                 @default(now()) @map("fecha_inscripcion")
  fechaBaja        DateTime?                @map("fecha_baja")
  estado           EstadoInscripcionMateria @default(ACTIVA)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  alumno         Alumno         @relation(fields: [alumnoId], references: [idAlumno], map: "inscripciones_espacios_alumno_fkey")
  cursadaEspacio CursadaEspacio @relation(fields: [cursadaEspacioId], references: [id], onDelete: Restrict, map: "inscripciones_espacios_oferta_fkey")
  componentes    InscripcionMateria[]

  @@unique([alumnoId, cursadaEspacioId], map: "inscripciones_espacios_alumno_oferta_unique")
  @@index([cursadaEspacioId, estado], map: "inscripciones_espacios_oferta_estado_idx")
  @@map("inscripciones_espacios")
}

model Cursada {
  id          Int            @id @default(autoincrement())
  materiaId   Int            @map("materia_id")
  anioLectivo Int            @map("anio_lectivo")
  periodo     PeriodoMateria @default(ANUAL)
  docenteId   Int?           @map("docente_id")
  activo      Boolean        @default(true)
  cursadaEspacioId Int?      @map("cursada_espacio_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  materia Materia  @relation(fields: [materiaId], references: [id])
  docente Usuario? @relation("DocenteCursada", fields: [docenteId], references: [idUsuario])
  cursadaEspacio CursadaEspacio? @relation(fields: [cursadaEspacioId], references: [id], onDelete: Restrict, map: "cursadas_espacio_fkey")

  inscripciones  InscripcionMateria[]
  asistencias    Asistencia[]
  calificaciones Calificacion[]
  horarios       Horario[]

  @@unique([cursadaEspacioId, materiaId], map: "cursadas_espacio_materia_unique")
  @@index([cursadaEspacioId], map: "cursadas_espacio_idx")
  @@unique([materiaId, anioLectivo, periodo])
  @@map("cursadas")
}

model CursadaEspacio {
  id                  Int           @id @default(autoincrement())
  espacioCurricularId Int           @map("espacio_curricular_id")
  anioLectivo         Int           @map("anio_lectivo")
  periodo             PeriodoMateria @default(ANUAL)
  activo              Boolean       @default(true)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  espacioCurricular EspacioCurricular @relation(fields: [espacioCurricularId], references: [id], onDelete: Restrict, map: "cursadas_espacios_espacio_fkey")
  componentes       Cursada[]
  periodos          PeriodoEspacioHabilitado[]
  inscripciones     InscripcionEspacio[]

  @@unique([espacioCurricularId, anioLectivo, periodo], map: "cursadas_espacios_espacio_anio_periodo_unique")
  @@index([anioLectivo, activo], map: "cursadas_espacios_anio_activo_idx")
  @@map("cursadas_espacios")
}

model Horario {
  id         Int       @id @default(autoincrement())
  cursadaId  Int       @map("cursada_id")
  dia        DiaSemana
  horaInicio DateTime  @map("hora_inicio")
  horaFin    DateTime  @map("hora_fin")
  aula       String?   @db.VarChar(50)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  cursada Cursada @relation(fields: [cursadaId], references: [id])

  @@map("horarios")
}

/// PDF institucional publicado para un ciclo lectivo. La clave interna nunca se expone
/// al cliente: únicamente se utiliza para resolver el archivo privado en disco.
model DocumentoHorario {
  id             Int      @id @default(autoincrement())
  cicloLectivo   Int      @map("ciclo_lectivo")
  ambitoClave    String   @default("GENERAL") @map("ambito_clave") @db.VarChar(64)
  carreraId      Int?     @map("carrera_id")
  cursoAnio      Int?     @map("curso_anio")
  titulo         String   @db.VarChar(160)
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  claveInterna   String   @unique @map("clave_interna") @db.Char(36)
  tamanio        Int
  sha256         String   @db.Char(64)
  publicadorId   Int      @map("publicador_id")
  createdAt      DateTime @default(now()) @map("created_at")

  publicador         Usuario             @relation("DocumentoHorarioPublicador", fields: [publicadorId], references: [idUsuario])
  carrera            Carrera?            @relation(fields: [carreraId], references: [id], onDelete: Restrict)
  publicacionVigente PublicacionHorario?

  @@unique([cicloLectivo, ambitoClave, sha256], map: "documentos_horarios_ciclo_ambito_sha256_key")
  @@index([cicloLectivo, createdAt], map: "documentos_horarios_ciclo_lectivo_created_at_idx")
  @@index([cicloLectivo, carreraId, cursoAnio], map: "documentos_horarios_ciclo_carrera_curso_idx")
  @@map("documentos_horarios")
}

/// Puntero al documento actualmente visible para cada ciclo lectivo. Las versiones
/// previas permanecen en DocumentoHorario y pueden restaurarse por administración.
model PublicacionHorario {
  id           Int      @id @default(autoincrement())
  cicloLectivo Int      @map("ciclo_lectivo")
  ambitoClave  String   @default("GENERAL") @map("ambito_clave") @db.VarChar(64)
  carreraId    Int?     @map("carrera_id")
  cursoAnio    Int?     @map("curso_anio")
  documentoId  Int      @unique @map("documento_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documento DocumentoHorario @relation(fields: [documentoId], references: [id])
  carrera   Carrera?         @relation(fields: [carreraId], references: [id], onDelete: Restrict)

  @@unique([cicloLectivo, ambitoClave], map: "publicaciones_horarios_ciclo_ambito_key")
  @@index([carreraId], map: "publicaciones_horarios_carrera_id_idx")
  @@map("publicaciones_horarios")
}

model Asistencia {
  id          Int      @id @default(autoincrement())
  cursadaId   Int      @map("cursada_id")
  alumnoId    Int      @map("alumno_id")
  fecha       DateTime @default(now())
  presente    Boolean  @default(true)
  justificado Boolean  @default(false)
  observacion String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cursada Cursada @relation(fields: [cursadaId], references: [id])
  alumno  Alumno  @relation(fields: [alumnoId], references: [idAlumno])

  @@unique([cursadaId, alumnoId, fecha])
  @@map("asistencias")
}

model Calificacion {
  id                Int              @id @default(autoincrement())
  cursadaId         Int              @map("cursada_id")
  alumnoId          Int              @map("alumno_id")
  tipoCalificacion  TipoCalificacion @map("tipo_calificacion")
  /// Número de instancia: Parcial 1, Parcial 2, TP 3, etc.
  numero            Int              @default(1)
  nota              Float
  fechaEvaluacion   DateTime?        @map("fecha_evaluacion") @db.Date
  fechaRegistro     DateTime         @default(now()) @map("fecha_registro")
  parcialOriginalId Int?             @unique(map: "calificaciones_parcial_original_id_key") @map("parcial_original_id")
  observacion       String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  cursada         Cursada       @relation(fields: [cursadaId], references: [id])
  alumno          Alumno        @relation(fields: [alumnoId], references: [idAlumno])
  parcialOriginal Calificacion? @relation("RecuperatorioParcial", fields: [parcialOriginalId], references: [id], onDelete: Restrict)
  recuperatorio   Calificacion? @relation("RecuperatorioParcial")

  @@unique([cursadaId, alumnoId, tipoCalificacion, numero], map: "calificaciones_cursada_alumno_tipo_numero_key")
  @@map("calificaciones")
}

/// Mesa de examen. folioExamen/libroExamen son del acta de la mesa
/// (iguales para todos los alumnos anotados), no de cada inscripción.
model Mesa {
  id               Int         @id @default(autoincrement())
  materiaId        Int         @map("materia_id")
  fecha            DateTime?
  tipoExamen       TipoExamen? @map("tipo_examen")
  llamado          Int?
  origen           OrigenMesa  @default(ORDINARIA)
  cicloLectivo     Int         @default(2026) @map("ciclo_lectivo")
  fechaCivil       DateTime?   @map("fecha_civil") @db.Date
  estadoMesa       EstadoMesa  @default(ABIERTA) @map("estado_mesa")
  version          Int         @default(0)
  publicadaEn      DateTime?   @map("publicada_en")
  reabiertaEn      DateTime?   @map("reabierta_en")
  reabiertaPor     Int?        @map("reabierta_por")
  motivoReapertura String?     @map("motivo_reapertura") @db.Text
  folioExamen      String?     @map("folio_examen") @db.VarChar(255)
  libroExamen      String?     @map("libro_examen") @db.VarChar(255)
  activo           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  materia               Materia                  @relation(fields: [materiaId], references: [id])
  tribunales            MesaTribunal[]
  inscripciones         InscripcionExamen[]
  periodosHabilitadores PeriodoMesaHabilitada[]
  auditoriasResultados  MesaResultadoAuditoria[]

  @@map("mesas")
}

model MesaTribunal {
  id          Int         @id @default(autoincrement())
  mesaId      Int         @map("mesa_id")
  profesorId  Int         @map("profesor_id")
  rolTribunal RolTribunal @default(VOCAL) @map("rol_tribunal")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  mesa     Mesa    @relation(fields: [mesaId], references: [id])
  profesor Usuario @relation(fields: [profesorId], references: [idUsuario])

  @@unique([mesaId, profesorId])
  @@map("mesas_tribunal")
}

model InscripcionExamen {
  id                    Int              @id @default(autoincrement())
  mesaId                Int              @map("mesa_id")
  alumnoId              Int              @map("alumno_id")
  fechaInscripcion      DateTime         @default(now()) @map("fecha_inscripcion")
  fechaBaja             DateTime?        @map("fecha_baja")
  notaFinal             Float?           @map("nota_final")
  condicion             CondicionExamen?
  version               Int              @default(0)
  historicoMateriaId    Int?             @map("historico_materia_id")
  inscripcionMateriaId  Int?             @map("inscripcion_materia_id")
  historicoCicloLectivo Int?             @map("historico_ciclo_lectivo")
  historicoFechaCivil   DateTime?        @map("historico_fecha_civil") @db.Date
  aprobado              Boolean?         @default(false)
  notaBorrador          Float?           @map("nota_borrador")
  ausenteBorrador       Boolean          @default(false) @map("ausente_borrador")
  ausentePublicado      Boolean          @default(false) @map("ausente_publicado")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  mesa                 Mesa                     @relation(fields: [mesaId], references: [id])
  alumno               Alumno                   @relation(fields: [alumnoId], references: [idAlumno])
  inscripcionMateria   InscripcionMateria?      @relation(fields: [inscripcionMateriaId], references: [id], onDelete: Restrict, map: "inscripciones_examenes_inscripcion_materia_fkey")
  auditoriasResultados MesaResultadoAuditoria[]

  @@unique([mesaId, alumnoId])
  @@unique([alumnoId, historicoMateriaId, historicoCicloLectivo, historicoFechaCivil], map: "inscripcion_examen_historico_dedupe")
  @@index([inscripcionMateriaId], map: "inscripciones_examenes_inscripcion_materia_idx")
  @@map("inscripciones_examenes")
}

model PromocionHistorica {
  id                 Int      @id @default(autoincrement())
  inscripcionMateriaId Int    @unique(map: "promociones_historicas_inscripcion_unique") @map("inscripcion_materia_id")
  alumnoId           Int      @map("alumno_id")
  notaFinal          Float    @map("nota_final")
  fechaAcreditacion  DateTime @map("fecha_acreditacion") @db.Date
  version            Int      @default(1)
  createdById        Int      @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  inscripcionMateria InscripcionMateria                  @relation(fields: [inscripcionMateriaId], references: [id], onDelete: Restrict, map: "promociones_historicas_inscripcion_fkey")
  alumno             Alumno                               @relation(fields: [alumnoId], references: [idAlumno], map: "promociones_historicas_alumno_fkey")
  createdBy          Usuario                              @relation("PromocionHistoricaCreador", fields: [createdById], references: [idUsuario], map: "promociones_historicas_created_by_fkey")
  auditorias         PromocionHistoricaAuditoria[]

  @@index([alumnoId, fechaAcreditacion], map: "promociones_historicas_alumno_fecha_idx")
  @@map("promociones_historicas")
}

model PromocionHistoricaAuditoria {
  id                   Int      @id @default(autoincrement())
  promocionHistoricaId Int      @map("promocion_historica_id")
  version              Int
  notaAnterior         Float?   @map("nota_anterior")
  notaNueva            Float    @map("nota_nueva")
  fechaAnterior        DateTime? @map("fecha_anterior") @db.Date
  fechaNueva           DateTime @map("fecha_nueva") @db.Date
  motivo               String   @db.Text
  actorId              Int      @map("actor_id")
  createdAt            DateTime @default(now()) @map("created_at")

  promocion PromocionHistorica @relation(fields: [promocionHistoricaId], references: [id], onDelete: Restrict, map: "promociones_historicas_auditoria_promocion_fkey")
  actor     Usuario            @relation(fields: [actorId], references: [idUsuario], map: "promociones_historicas_auditoria_actor_fkey")

  @@unique([promocionHistoricaId, version], map: "promociones_historicas_auditoria_version_unique")
  @@index([promocionHistoricaId, createdAt], map: "promociones_historicas_auditoria_fecha_idx")
  @@map("promociones_historicas_auditoria")
}

model MesaResultadoAuditoria {
  id              Int                 @id @default(autoincrement())
  mesaId          Int                 @map("mesa_id")
  inscripcionId   Int?                @map("inscripcion_id")
  actorId         Int                 @map("actor_id")
  accion          AccionResultadoMesa
  motivo          String?             @db.Text
  notaAnterior    Float?              @map("nota_anterior")
  notaNueva       Float?              @map("nota_nueva")
  ausenteAnterior Boolean?            @map("ausente_anterior")
  ausenteNuevo    Boolean?            @map("ausente_nuevo")
  createdAt       DateTime            @default(now()) @map("created_at")

  mesa        Mesa               @relation(fields: [mesaId], references: [id])
  inscripcion InscripcionExamen? @relation(fields: [inscripcionId], references: [id])
  actor       Usuario            @relation(fields: [actorId], references: [idUsuario])

  @@index([mesaId, createdAt])
  @@index([inscripcionId])
  @@map("mesas_resultados_auditoria")
}

model ProfesorMateria {
  id              Int       @id @default(autoincrement())
  profesorId      Int       @map("profesor_id")
  materiaId       Int       @map("materia_id")
  fechaAsignacion DateTime  @default(now()) @map("fecha_asignacion")
  fechaBaja       DateTime? @map("fecha_baja")
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profesor Usuario @relation(fields: [profesorId], references: [idUsuario])
  materia  Materia @relation(fields: [materiaId], references: [id])

  @@unique([profesorId, materiaId])
  @@map("profesores_materias")
}

model Homologacion {
  id                     Int                @id @default(autoincrement())
  alumnoId               Int                @map("alumno_id")
  materiaId              Int                @map("materia_id")
  tipoHomologacion       TipoHomologacion   @map("tipo_homologacion")
  calificacion           Float?
  fechaHomologacion      DateTime           @default(now()) @map("fecha_homologacion")
  notaExamenHomologacion Float?             @map("nota_examen_homologacion")
  estado                 EstadoHomologacion @default(PENDIENTE)
  observacion            String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  alumno  Alumno  @relation(fields: [alumnoId], references: [idAlumno])
  materia Materia @relation(fields: [materiaId], references: [id])

  @@unique([alumnoId, materiaId])
  @@map("homologaciones")
}

/// Cada registro es una entrada del libro de temas: por cada día que el
/// profesor carga asistencia de una Materia, se crea un registro acá con
/// el tema desarrollado. No es "el libro" completo, es cada fila.
model LibroDeTema {
  idLibroDeTema    Int      @id @default(autoincrement())
  materiaId        Int      @map("materia_id")
  fecha            DateTime @db.Date
  temaDesarrollado String   @db.Text
  observaciones    String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  materia Materia @relation(fields: [materiaId], references: [id])

  @@map("libro_de_temas")
}

// ============================================
// PERÍODOS DE INSCRIPCIÓN
// ============================================

model PeriodoInscripcion {
  id           Int         @id @default(autoincrement())
  tipo         TipoPeriodo // MATERIA o EXAMEN
  cicloLectivo Int         @map("ciclo_lectivo")
  fechaInicio  DateTime    @map("fecha_inicio")
  fechaFin     DateTime    @map("fecha_fin")
  descripcion  String?     @db.VarChar(255)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  /// Materias habilitadas explícitamente por este período (tipo=MATERIA).
  /// El administrativo las selecciona por carrera y año al crearlo.
  materias PeriodoMateriaHabilitada[]
  /// Mesas de examen habilitadas por este período (tipo=EXAMEN).
  mesas    PeriodoMesaHabilitada[]
  cursadasEspacios PeriodoEspacioHabilitado[]

  @@map("periodos_inscripcion")
}

/// Materias que un período de inscripción habilita (selección explícita
/// del administrativo por carrera/año).
model PeriodoMateriaHabilitada {
  id                   Int @id @default(autoincrement())
  periodoInscripcionId Int @map("periodo_inscripcion_id")
  materiaId            Int @map("materia_id")

  periodoInscripcion PeriodoInscripcion @relation(fields: [periodoInscripcionId], references: [id], onDelete: Cascade)
  materia            Materia            @relation(fields: [materiaId], references: [id])

  @@unique([periodoInscripcionId, materiaId])
  @@map("periodos_materias")
}

/// Mesas de examen que un período de inscripción habilita (selección
/// explícita del administrativo al abrir el llamado).
model PeriodoMesaHabilitada {
  id                   Int @id @default(autoincrement())
  periodoInscripcionId Int @map("periodo_inscripcion_id")
  mesaId               Int @map("mesa_id")

  periodoInscripcion PeriodoInscripcion @relation(fields: [periodoInscripcionId], references: [id], onDelete: Cascade)
  mesa               Mesa               @relation(fields: [mesaId], references: [id])

  @@unique([periodoInscripcionId, mesaId])
  @@map("periodos_mesas")
}

/// Ofertas completas de espacios que un período tipo MATERIA habilita.
model PeriodoEspacioHabilitado {
  id                   Int @id @default(autoincrement())
  periodoInscripcionId Int @map("periodo_inscripcion_id")
  cursadaEspacioId     Int @map("cursada_espacio_id")

  periodoInscripcion PeriodoInscripcion @relation(fields: [periodoInscripcionId], references: [id], onDelete: Cascade, map: "periodos_espacios_periodo_fkey")
  cursadaEspacio     CursadaEspacio     @relation(fields: [cursadaEspacioId], references: [id], onDelete: Cascade, map: "periodos_espacios_oferta_fkey")

  @@unique([periodoInscripcionId, cursadaEspacioId], map: "periodos_espacios_periodo_oferta_unique")
  @@index([cursadaEspacioId], map: "periodos_espacios_oferta_idx")
  @@map("periodos_espacios")
}
